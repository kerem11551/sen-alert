<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070707">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.senalert.app.ShakeOrbView
            android:id="@+id/orbView"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/stateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="SABİT"
            android:textColor="#22E88A"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/subText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="Normal seviyede"
            android:textColor="#8A9C9A"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/lastStrongText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Son Güçlü Sarsıntı: —"
            android:textColor="#5E7472"
            android:textSize="11sp"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/alertBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:gravity="center"
            android:visibility="gone"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#808080"/>

        <Button
            android:id="@+id/btnMute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SUSTUR"
            android:backgroundTint="#FF3B30"
            android:textColor="#FFFFFF"
            android:visibility="gone"/>

        <com.senalert.app.EkgGraphView
            android:id="@+id/ekgView"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="20dp"
            android:background="#0a1112"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Son 6 Saniye"
            android:textColor="#5E7472"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="18dp"
            android:padding="14dp"
            android:background="#0F1517">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANLIK SARSINTI SEVİYESİ"
                android:textColor="#5E7472"
                android:textSize="11sp"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/levelNumberText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#22E88A"
                android:textSize="42sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/ 100"
                android:textColor="#5E7472"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnInfoToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:padding="8dp"
            android:text="ℹ️ Teknik Bilgi"
            android:textColor="#5E7472"
            android:textSize="12sp"/>

        <LinearLayout
            android:id="@+id/detailsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#0F1517"
            android:padding="12dp"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/sensorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="X: 0.00  Y: 0.00  Z: 0.00\nΔXY: 0.00  ΔZ: 0.00"
                android:textColor="#5E7472"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="center"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnRecalibrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="YENİDEN KALİBRE ET"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OLAYI KAYDET"/>

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AYARLAR"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
