<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070707">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BAŞLAT"
            android:backgroundTint="#22E88A"
            android:textColor="#000000"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnSetupToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:padding="6dp"
            android:text="🛠️ Kurulum Kontrolü"
            android:textColor="#8A9C9A"
            android:textSize="12sp"/>

        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#0F1517"
            android:padding="14dp"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/setupNotifStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bildirim İzni: —"
                android:textColor="#DCE7E5"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnFixNotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="İzin Ver"
                android:backgroundTint="#22E88A"
                android:textColor="#000000"
                android:layout_marginTop="6dp"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C2A2C"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/setupBatteryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pil Optimizasyonu: —"
                android:textColor="#DCE7E5"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnFixBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kısıtlamayı Kaldır"
                android:backgroundTint="#22E88A"
                android:textColor="#000000"
                android:layout_marginTop="6dp"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C2A2C"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Otomatik Başlatma (cihaz markanıza göre ayrı bir ayar olabilir)"
                android:textColor="#DCE7E5"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnFixAutostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ayarları Aç"
                android:backgroundTint="#0F1517"
                android:textColor="#FFFFFF"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <com.senalert.app.ShakeOrbView
            android:id="@+id/orbView"
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/stateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="İZLEME DURDU"
            android:textColor="#8A9C9A"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/lastAlertText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Son Uyarı: —"
            android:textColor="#5E7472"
            android:textSize="12sp"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/alertBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:gravity="center"
            android:visibility="gone"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#808080"/>

        <TextView
            android:id="@+id/btnMute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:padding="4dp"
            android:text="🔕 Uyarıyı Sustur"
            android:textColor="#FF3B30"
            android:textSize="12sp"
            android:visibility="invisible"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="ANLIK SARSINTI SEVİYESİ"
            android:textColor="#DCE7E5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"/>

        <com.senalert.app.EkgGraphView
            android:id="@+id/ekgView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="#0a1112"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Son 6 Saniye"
            android:textColor="#8A9C9A"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/btnInfoToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:padding="8dp"
            android:text="ℹ️ Teknik Bilgi"
            android:textColor="#8A9C9A"
            android:textSize="12sp"/>

        <LinearLayout
            android:id="@+id/detailsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#0F1517"
            android:padding="12dp"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/sensorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="X: 0.00  Y: 0.00  Z: 0.00\nΔXY: 0.00  ΔZ: 0.00"
                android:textColor="#DCE7E5"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="center"/>

            <TextView
                android:id="@+id/lastBroadcastText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Son Veri Güncellemesi: —"
                android:textColor="#22E88A"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="Seviye ölçeği: 🟢 0-29 Düşük · 🟡 30-69 Orta · 🔴 70-100 Yüksek"
                android:textColor="#8A9C9A"
                android:textSize="10sp"
                android:gravity="center"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C2A2C"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sen-Alert, cihazın bulunduğu noktadaki sarsıntıyı internet bağlantısı gerektirmeden, dahili hareket sensörlerini kullanarak sürekli izler. Amacı panik oluşturmak değil, olası bir sarsıntı durumunda kullanıcıya mümkün olan en kısa sürede farkındalık kazandırmaktır.\n\nSarsıntı seviyeleri (Yeşil / Sarı / Kırmızı), cihazın dahili hareket sensörlerinden alınan verilerin analizine göre belirlenir. Eşik değerleri gerçek kullanım testleriyle optimize edilmiştir.\n\nBu uygulama bir deprem büyüklüğü veya deprem şiddeti ölçüm cihazı değildir. Ölçülen değerler; cihazın modeli, sensör özellikleri, bulunduğu yüzey ve konum gibi etkenlere bağlı olarak değişebilir. Sen-Alert, yalnızca cihazın bulunduğu noktadaki sarsıntıyı algılayarak kullanıcıyı mümkün olan en kısa sürede ses, titreşim ve ışık bildirimleriyle uyarmayı amaçlar."
                android:textColor="#8A9C9A"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C2A2C"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="CANLI ALGORİTMA KARŞILAŞTIRMA (TEST MODU)"
                android:textColor="#FFD60A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/testModeOffNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Test Modu kapalı - Ayarlar'dan açabilirsiniz"
                android:textColor="#5E7472"
                android:textSize="10sp"/>

            <LinearLayout
                android:id="@+id/comparisonPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="MEVCUT V1 (XY)" android:textColor="#5E7472" android:textSize="9sp"/>
                        <TextView
                            android:id="@+id/cmpSxy"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0.00" android:textColor="#DCE7E5" android:textSize="18sp" android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/cmpSxyState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="NORMAL" android:textColor="#22E88A" android:textSize="11sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="TEST V1.1 (XYZ w=0.3)" android:textColor="#5E7472" android:textSize="9sp"/>
                        <TextView
                            android:id="@+id/cmpSxyz"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0.00" android:textColor="#DCE7E5" android:textSize="18sp" android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/cmpSxyzState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="NORMAL" android:textColor="#22E88A" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#1C2A2C" android:layout_marginTop="10dp" android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TEPKİ SÜRELERİ (SON BÖLÜM)"
                    android:textColor="#5E7472" android:textSize="9sp" android:layout_gravity="center_horizontal"/>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="🟡 Sarı: XY" android:textColor="#8A9C9A" android:textSize="11sp"/>
                    <TextView
                        android:id="@+id/cmpYellowXy"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="—" android:textColor="#DCE7E5" android:textSize="11sp" android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="🟡 Sarı: XYZ" android:textColor="#8A9C9A" android:textSize="11sp"/>
                    <TextView
                        android:id="@+id/cmpYellowXyz"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="—" android:textColor="#DCE7E5" android:textSize="11sp" android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="🔴 Kırmızı: XY" android:textColor="#8A9C9A" android:textSize="11sp"/>
                    <TextView
                        android:id="@+id/cmpRedXy"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="—" android:textColor="#DCE7E5" android:textSize="11sp" android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="🔴 Kırmızı: XYZ" android:textColor="#8A9C9A" android:textSize="11sp"/>
                    <TextView
                        android:id="@+id/cmpRedXyz"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="—" android:textColor="#DCE7E5" android:textSize="11sp" android:gravity="end"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnSaveCsv"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="💾 TESTİ KAYDET (CSV)"
                    android:backgroundTint="#FFD60A" android:textColor="#000000"
                    android:layout_marginTop="14dp"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnRecalibrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="YENİDEN KALİBRE ET"
            android:backgroundTint="#0F1517"
            android:textColor="#FFFFFF"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="AYARLAR"
            android:backgroundTint="#0F1517"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>
