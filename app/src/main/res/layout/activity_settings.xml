<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070707">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hassasiyet"
            android:textColor="#FFFFFF"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1: kamyon geçse bile alarm vermez · 5: ev kullanımı · 10: bebek odası"
            android:textColor="#5E7472"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

        <SeekBar
            android:id="@+id/seekSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvSensitivityValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟡 Sarsıntı Algılandı"
            android:textColor="#FFD60A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <CheckBox
            android:id="@+id/cbYellowSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ses"
            android:textColor="#FFFFFF"
            android:layout_marginTop="6dp"/>

        <CheckBox
            android:id="@+id/cbYellowVib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titreşim"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"/>

        <CheckBox
            android:id="@+id/cbYellowFlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flaş"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 Güçlü Sarsıntı"
            android:textColor="#FF3B30"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alarm 4 saniye çalar ve otomatik durur — panik yaratmamak için sınırsız çalmaz."
            android:textColor="#5E7472"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

        <CheckBox
            android:id="@+id/cbRedSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tam Ses (Alarm)"
            android:textColor="#FFFFFF"
            android:layout_marginTop="6dp"/>

        <CheckBox
            android:id="@+id/cbRedVib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titreşim"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"/>

        <CheckBox
            android:id="@+id/cbRedFlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flaş"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"/>

        <CheckBox
            android:id="@+id/cbRedWake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ekranı Aç"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AYARLARI KAYDET"
            android:backgroundTint="#22E88A"
            android:textColor="#000000"
            android:layout_marginTop="28dp"/>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GERİ"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
