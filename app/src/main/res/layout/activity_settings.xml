<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070707">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hassasiyet"
            android:textColor="#FFFFFF"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1: kamyon geçse bile alarm vermez · 5: ev kullanımı · 10: bebek odası"
            android:textColor="#8A9C9A"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

        <SeekBar
            android:id="@+id/seekSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvSensitivityValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:background="#0F1517"
            android:text="Sarsıntı seviyeleri, cihazın dahili hareket sensörlerinden alınan verilere göre hesaplanır. Bu uygulama deprem büyüklüğünü veya şiddetini ölçmez; yalnızca cihazın bulunduğu noktadaki sarsıntıyı izleyerek gerektiğinde uyarı verir."
            android:textColor="#8A9C9A"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bildirim Türleri"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hem sarsıntı hem güçlü sarsıntı için aynı ayar geçerlidir - eşik farklıdır, uyarı türü aynıdır."
            android:textColor="#8A9C9A"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

        <CheckBox
            android:id="@+id/cbSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊 Ses"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>

        <CheckBox
            android:id="@+id/cbVib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📳 Titreşim"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"/>

        <CheckBox
            android:id="@+id/cbFlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔦 Flaş"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uyarı Süresi"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uyarı bu süre kadar çalar, sonra otomatik durur. Durum devam ederse 20 saniye sonra bir kez daha tekrarlanır."
            android:textColor="#8A9C9A"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

        <RadioGroup
            android:id="@+id/durationGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/dur3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 sn"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="20dp"/>

            <RadioButton
                android:id="@+id/dur5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 sn"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="20dp"/>

            <RadioButton
                android:id="@+id/dur10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 sn"
                android:textColor="#FFFFFF"/>

        </RadioGroup>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AYARLARI KAYDET"
            android:backgroundTint="#22E88A"
            android:textColor="#000000"
            android:layout_marginTop="28dp"/>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GERİ"
            android:background="@drawable/btn_outline"
            android:textColor="#DCE7E5"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
